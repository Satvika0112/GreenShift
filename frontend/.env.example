# GreenShift Frontend Configuration
# Leave VITE_API_BASE_URL empty to route all API calls via:
# - Vite development proxy (in dev: http://localhost:3000 -> http://127.0.0.1:8000)
# - Nginx reverse proxy (in production/Docker: http://localhost:3000 -> http://api:8000)
# Only set this if connecting directly to an external API gateway with CORS enabled.
VITE_API_BASE_URL=
