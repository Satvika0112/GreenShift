# ─────────────────────────────────────────────────────────────────────────────
# GreenShift .dockerignore — Prevent secrets and temporary files in images
# ─────────────────────────────────────────────────────────────────────────────

# Environment & Secrets (NEVER bake into images)
.env
.env.*
!.env.example
k8s/secrets.yaml

# Git & IDE
.git
.gitignore
.idea
.vscode

# Python cache & virtual environments
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# Database files & logs
*.db
*.sqlite
*.sqlite3
*.log
logs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
