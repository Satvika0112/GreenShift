# GreenShift — environment variables for local development
# Copy to .env and fill in your values
# NEVER commit .env to Git

# ─── Carbon API ───────────────────────────────────────────────
ELECTRICITY_MAPS_API_KEY=
CARBON_API_BASE_URL=https://api.electricitymap.org/v3
CARBON_REGION=IN-SO

# ─── Tariff API ───────────────────────────────────────────────
TARIFF_API_KEY=
TARIFF_API_BASE_URL=https://api.example-tariff.com/v1

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL (Production / Docker):
POSTGRES_DB=greenshift
POSTGRES_USER=greenshift
# REQUIRED in production: Strong database password (no default fallback)
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=greenshift-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://greenshift:your_secure_postgres_password_here@localhost:5432/greenshift

# SQLite (Alternative Local Development Fallback):
# DATABASE_URL=sqlite:///./greenshift.db

# ─── Kubernetes ───────────────────────────────────────────────
# KUBECONFIG is auto-detected from ~/.kube/config or KUBECONFIG env var
K8S_NAMESPACE=greenshift
K8S_IN_CLUSTER=false
# Optional overrides for out-of-cluster / containerised dev:
# KUBECONFIG_PATH=
# K8S_HOST_OVERRIDE=https://host.docker.internal:63799
# K8S_INSECURE_SKIP_TLS_VERIFY=false

# ─── Application & Security ───────────────────────────────────
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Enable JWT authentication and RBAC.
# MUST be true in production. When false (default), all endpoints are open.
AUTH_ENABLED=false

# REQUIRED in production: Secret key used for signing JWT access tokens
# Must be at least 32 cryptographically secure characters (e.g. generate via: openssl rand -hex 32)
JWT_SECRET_KEY=your_cryptographically_secure_jwt_secret_key_min_32_chars_here

# Example API key for CI/CD pipelines (generated via POST /admin/api-keys)
# GREENSHIFT_API_KEY=gs_<your-api-key-here>

# Comma-separated list of allowed CORS origins for API clients
# NEVER use '*' with credentials in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8501,http://127.0.0.1:3000,http://127.0.0.1:8000,http://127.0.0.1:8501

# ─── Phase 4 Security: Internal Service Auth & Transport Security ──
# Optional shared secret for internal microservice-to-microservice calls.
# If set, endpoints protected by require_internal_service_token() validate
# the X-Internal-Service-Key header against this value using constant-time comparison.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER expose this token to the browser or include in frontend/client code.
INTERNAL_SERVICE_KEY=

# Explicitly enable Strict-Transport-Security (HSTS) response header.
# Automatically enabled when ENVIRONMENT=production or X-Forwarded-Proto: https.
# Set to true only in HTTPS deployments outside of production environment.
ENABLE_HSTS=false

# ─── Cache & Redis ────────────────────────────────────────────
CACHE_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379/0
CARBON_CACHE_TTL_SECONDS=900

# ─── Real Data Sources ────────────────────────────────────────
# Workload CSV (560 jobs)
JOB_DATA_PATH=data/greenshift_workloads_final.csv

# Master ToD Regional Tariff CSV (IN-TG, IN-GJ, IN-WB, IN-PB, US-CA, US-NY, US-TX, SE, AU-SA-Large, AU-SA-Small)
MASTER_TARIFF_DATASET=data/master_tod_tariff_all_regions.csv

# Currency conversion rates to USD
TARIFF_INR_TO_USD=0.012
TARIFF_SEK_TO_USD=0.095
TARIFF_AUD_TO_USD=0.65

# Job types that map to HT-I(A) Industry General tariff (others map to HT-II(A))
TARIFF_INDUSTRIAL_TYPES=DATA_PROCESSING,ETL,HPC,BATCH,SIMULATION

# Synthetic fallback gates (set to false to disallow synthetic data)
ALLOW_SYNTHETIC_CARBON=true
ALLOW_SYNTHETIC_TARIFF=true

# ─── Dispatcher ───────────────────────────────────────────────
DISPATCHER_POLL_INTERVAL_SECONDS=30

# ─── Audit Anchoring ──────────────────────────────────────────
AUDIT_ANCHOR_PATH=data/audit_anchors.jsonl

# ─── Notification Email Delivery ───────────────────────────────
# Off by default — in-app notifications always work regardless of SMTP config.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Verified sender address. Leave unset to fall back to SMTP_USERNAME at send
# time — most providers reject a From address that isn't the authenticated
# account or a verified alias, so don't set this to a domain you don't own.
SMTP_FROM_ADDRESS=
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_POLL_INTERVAL_SECONDS=15
# Base URL used to build links back into the app from notification emails.
FRONTEND_BASE_URL=http://localhost:3000
