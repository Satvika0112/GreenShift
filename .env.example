# GreenShift — environment variables for local development
# Copy to .env and fill in your values
# NEVER commit .env to Git

# ─── Carbon API ───────────────────────────────────────────────
ELECTRICITY_MAPS_API_KEY=
CARBON_API_BASE_URL=https://api.electricitymap.org/v3
CARBON_REGION=IN-SO

# ─── Tariff API ───────────────────────────────────────────────
TARIFF_API_KEY=
TARIFF_API_BASE_URL=https://api.example-tariff.com/v1

# ─── Database ─────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./greenshift.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://greenshift:password@postgres:5432/greenshift

# ─── Kubernetes ───────────────────────────────────────────────
# KUBECONFIG is auto-detected from ~/.kube/config
K8S_NAMESPACE=greenshift
K8S_IN_CLUSTER=false

# ─── Application ──────────────────────────────────────────────
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# ─── Cache ────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ─── Real Data Sources ────────────────────────────────────────
# Workload CSV (560 jobs)
JOB_DATA_PATH=data/greenshift_workloads_final.csv

# Indian Regional Tariff CSVs
TARIFF_HT1_PATH=data/telangana_tod_tariff_ht1a.csv
TARIFF_HT2_PATH=data/telangana_tod_tariff_ht2a.csv
TARIFF_GJ_PATH=data/gujarat_tod_tariff_hourly_FY2026-27.csv
TARIFF_HP_PATH=data/himachal_pradesh_flat_tariff_hourly_FY2026-27.csv
TARIFF_WB_PATH=data/west_bengal_tod_tariff_hourly_FY2026-27.csv

# INR to USD conversion rate
TARIFF_INR_TO_USD=0.012

# Job types that map to HT-I(A) Industry General tariff (others map to HT-II(A))
TARIFF_INDUSTRIAL_TYPES=DATA_PROCESSING,ETL,HPC,BATCH,SIMULATION

# Synthetic fallback gates (set to false to disallow synthetic data)
ALLOW_SYNTHETIC_CARBON=true
ALLOW_SYNTHETIC_TARIFF=true

# ─── Dispatcher ───────────────────────────────────────────────
DISPATCHER_POLL_INTERVAL_SECONDS=30
