# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.dashboard — GreenShift Streamlit Dashboard
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim AS base

RUN groupadd -r -g 1000 greenshift && useradd -r -u 1000 -g greenshift -m -d /home/greenshift greenshift

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
RUN chown -R greenshift:greenshift /home/greenshift /app

USER greenshift

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

CMD ["streamlit", "run", "app/dashboard/main.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
